{
  "name": "tepirek-revamped",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "better-auth": "^1.7.2",
      "dotenv": "^17.4.2",
      "@effect/sql-pg": "4.0.0-beta.101",
      "@effect/vitest": "4.0.0-beta.101",
      "@types/pg": "8.20.0",
      "drizzle-kit": "1.0.0-rc.4",
      "drizzle-orm": "1.0.0-rc.4",
      "effect": "4.0.0-beta.101",
      "hono": "^4.13.5",
      "pg": "8.22.0",
      "typescript": "7.0.2",
      "vitest": "^4.1.11",
      "zod": "^4.4.3",
      "linkedom": "^0.18.13"
    }
  },
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "test:integration": "turbo -F @tepirek-revamped/api test:integration",
    "test:smoke": "turbo test:smoke",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @tepirek-revamped/db db:push",
    "db:studio": "turbo -F @tepirek-revamped/db db:studio",
    "db:generate": "turbo -F @tepirek-revamped/db db:generate",
    "db:migrate": "turbo -F @tepirek-revamped/db db:migrate",
    "db:start": "turbo -F @tepirek-revamped/db db:start",
    "db:watch": "turbo -F @tepirek-revamped/db db:watch",
    "db:stop": "turbo -F @tepirek-revamped/db db:stop",
    "db:down": "turbo -F @tepirek-revamped/db db:down",
    "check": "ultracite check",
    "check:unused": "knip",
    "fix": "ultracite fix",
    "prepare": "effect-tsgo patch"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.39.1",
    "@tepirek-revamped/config": "workspace:*",
    "@types/node": "^24.10.13",
    "knip": "^6.34.0",
    "lefthook": "latest",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.10.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.8.3",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "nub@0.8.3",
  "allowBuilds": {
    "esbuild": true,
    "msgpackr-extract": true,
    "lefthook": true
  }
}
