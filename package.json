{
  "name": "tepirek-revamped",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "infisical run --env=dev --path=/ -- vp run --filter web --filter server --parallel --no-cache dev",
    "build": "vp run -r --cache build",
    "check-types": "vp run -r --no-cache check-types",
    "test": "vp test run",
    "test:integration": "vp run --no-cache --filter @tepirek-revamped/api test:integration",
    "test:smoke": "vp run -r --no-cache test:smoke",
    "dev:web": "infisical run --env=dev --path=/ -- vp run --no-cache --filter web dev",
    "dev:server": "infisical run --env=dev --path=/ -- vp run --no-cache --filter server dev",
    "db:push": "infisical run --env=dev --path=/ -- vp run --no-cache --filter @tepirek-revamped/db db:push",
    "db:studio": "infisical run --env=dev --path=/ -- vp run --no-cache --filter @tepirek-revamped/db db:studio",
    "db:generate": "infisical run --env=dev --path=/ -- vp run --no-cache --filter @tepirek-revamped/db db:generate",
    "db:migrate": "infisical run --env=dev --path=/ -- vp run --no-cache --filter @tepirek-revamped/db db:migrate",
    "db:start": "infisical run --env=dev --path=/ -- vp run --no-cache --filter @tepirek-revamped/db db:start",
    "db:watch": "infisical run --env=dev --path=/ -- vp run --no-cache --filter @tepirek-revamped/db db:watch",
    "db:stop": "infisical run --env=dev --path=/ -- vp run --no-cache --filter @tepirek-revamped/db db:stop",
    "db:down": "infisical run --env=dev --path=/ -- vp run --no-cache --filter @tepirek-revamped/db db:down",
    "check": "vp check",
    "check:unused": "knip",
    "fix": "vp check --fix",
    "prepare": "effect-tsgo patch && vp config --no-agent"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.51.1",
    "@oxlint/plugins": "1.87.0",
    "@tepirek-revamped/config": "workspace:*",
    "@types/node": "^26.6.5",
    "knip": "^6.41.0",
    "typescript": "catalog:",
    "ultracite": "8.0.0",
    "vite-plus": "1.1.0"
  },
  "engines": {
    "node": ">=26",
    "pnpm": "12.9.1"
  },
  "packageManager": "pnpm@12.9.1"
}
