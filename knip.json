{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "drizzle": false,
  "exclude": ["duplicates"],
  "ignore": [
    "apps/web/src/components/reui/**",
    "apps/web/src/components/ui/**",
    "packages/db/drizzle.config.ts",
    "tools/oxlint/anti-slop/**"
  ],
  "ignoreDependencies": [
    "@effect/language-service",
    "@opentelemetry/api",
    "dotenv"
  ],
  "workspaces": {
    "apps/server": {
      "vitest": {
        "entry": ["src/*.test.ts"]
      }
    }
  }
}
