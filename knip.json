{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "drizzle": false,
  "exclude": ["duplicates"],
  "ignore": ["apps/web/src/components/ui/**", "packages/db/drizzle.config.ts"],
  "ignoreDependencies": [
    "@effect/language-service",
    "@vitest/coverage-v8",
    "dotenv"
  ],
  "ignoreBinaries": ["infisical"],
  "workspaces": {
    "packages/api": {
      "vitest": {
        "config": ["vitest*.config.ts"]
      }
    },
    "apps/server": {
      "vitest": {
        "config": ["vitest*.config.ts"],
        "entry": ["src/*.test.ts"]
      }
    }
  }
}
