{
  "$schema": "../../node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "lib": ["ESNext"],
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "types": ["node"],
    "strictNullChecks": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        // Accepted, version-pinned Effect v4 integrations; other unstable APIs still warn.
        "allowedUnstableApis": [
          "@effect/platform-node-shared/NodeCrypto#layer",
          "@effect/platform-node/NodeFileSystem#layer",
          "@effect/platform-node/NodeRuntime#runMain",
          "@effect/sql-pg/PgClient",
          "@effect/vitest#it",
          "effect/ConfigProvider#fromDotEnv",
          "effect/crypto/SecureRandom#SecureRandom",
          "effect/http",
          "effect/http-api",
          "effect/observability/OtlpLogger#layerFromConfig",
          "effect/observability/OtlpSerialization#layerJson",
          "effect/observability/OtlpTracer#layerFromConfig",
          "effect/sql/SqlError"
        ],
        "diagnosticSeverity": {
          "lazyEffect": "off"
        }
      }
    ]
  }
}
