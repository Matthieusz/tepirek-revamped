{
  "extends": "@tepirek-revamped/config/tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "strictNullChecks": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        // Accepted, version-pinned Effect v4 integrations; other unstable APIs still warn.
        "allowedUnstableApis": [
          "@effect/platform-node/NodeCrypto#layer",
          "@effect/platform-node/NodeFileSystem#layer",
          "@effect/platform-node/NodeRuntime#runMain",
          "@effect/sql-pg/PgClient",
          "@effect/vitest#it",
          "effect/ConfigProvider#fromDotEnv",
          "effect/Crypto#Crypto",
          "effect/http",
          "effect/http-api",
          "effect/observability/OtlpLogger#layerFromConfig",
          "effect/observability/OtlpSerialization#layerJson",
          "effect/observability/OtlpTracer#layerFromConfig",
          "effect/sql/SqlError"
        ],
        "diagnosticSeverity": {
          "lazyEffect": "off"
        },
        "overrides": [
          {
            "include": ["src/**/*.ts"],
            "exclude": ["src/**/*.test.ts"],
            "options": {
              "diagnosticSeverity": {
                "globalFetch": "error",
                "globalFetchInEffect": "error",
                "globalRandom": "error",
                "globalRandomInEffect": "error",
                "globalTimers": "error",
                "globalTimersInEffect": "error",
                "processEnv": "error",
                "processEnvInEffect": "error",
                "unsafeEffectTypeAssertion": "error"
              }
            }
          }
        ]
      }
    ]
  }
}
