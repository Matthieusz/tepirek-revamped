{
  "extends": "@tepirek-revamped/config/tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "strictNullChecks": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "lazyEffect": "off"
        },
        "overrides": [
          {
            "include": ["src/**/*.ts"],
            "exclude": ["src/**/*.test.ts"],
            "options": {
              "diagnosticSeverity": {
                "globalFetch": "error",
                "globalFetchInEffect": "error",
                "globalRandom": "error",
                "globalRandomInEffect": "error",
                "globalTimers": "error",
                "globalTimersInEffect": "error",
                "processEnv": "error",
                "processEnvInEffect": "error",
                "unsafeEffectTypeAssertion": "error"
              }
            }
          }
        ]
      }
    ]
  }
}
