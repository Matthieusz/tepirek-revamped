{
  "name": "server",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "vp pack",
    "check-types": "tsc -b",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "sync:legend-catalog": "tsx src/sync-legend-catalog.ts",
    "test": "vp test run src/server-lifecycle.test.ts src/startup-config.test.ts",
    "test:smoke": "vp test run --config vitest.smoke.config.ts",
    "db:push": "pnpm --filter @tepirek-revamped/db db:push"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.3",
    "@hono/node-server": "^2.1.5",
    "@opentelemetry/api": "^1.9.1",
    "@tepirek-revamped/api": "workspace:*",
    "@tepirek-revamped/auth": "workspace:*",
    "@tepirek-revamped/db": "workspace:*",
    "effect": "catalog:",
    "evlog": "^2.32.0",
    "hono": "catalog:",
    "ofetch": "^1.5.1"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@tepirek-revamped/config": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
