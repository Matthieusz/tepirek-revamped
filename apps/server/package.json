{
  "name": "server",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "dev": "nub watch src/index.ts",
    "start": "node dist/index.mjs",
    "sync:legend-catalog": "nub src/sync-legend-catalog.ts",
    "test": "vitest run src/server-lifecycle.test.ts src/startup-config.test.ts",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "db:push": "nub run --filter @tepirek-revamped/db db:push"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.101",
    "@hono/node-server": "^2.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@tepirek-revamped/api": "workspace:*",
    "@tepirek-revamped/auth": "workspace:*",
    "@tepirek-revamped/db": "workspace:*",
    "effect": "catalog:",
    "evlog": "^2.26.0",
    "hono": "catalog:",
    "ofetch": "^1.5.1"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@tepirek-revamped/config": "workspace:*",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
