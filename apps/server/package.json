{
  "name": "server",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "vp pack",
    "check-types": "tsrs --noEmit --project tsconfig.json",
    "dev": "varlock load --agent && tsx watch src/index.ts",
    "start": "varlock load --agent && node dist/index.mjs",
    "start:deploy": "varlock load --agent && sh -c 'pnpm --filter @tepirek-revamped/db db:migrate && exec node dist/index.mjs'",
    "sync:legend-catalog": "tsx src/sync-legend-catalog.ts",
    "test": "vp test run src/server-lifecycle.test.ts src/startup-config.test.ts",
    "test:smoke": "vp test run --config vitest.smoke.config.ts",
    "db:push": "pnpm --filter @tepirek-revamped/db db:push"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.6",
    "@hono/node-server": "^2.1.5",
    "@opentelemetry/api": "^1.10.0",
    "@tepirek-revamped/api": "workspace:*",
    "@tepirek-revamped/auth": "workspace:*",
    "@tepirek-revamped/db": "workspace:*",
    "effect": "catalog:",
    "evlog": "^2.33.1",
    "hono": "catalog:",
    "ofetch": "^1.5.1"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@tepirek-revamped/config": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
